# Copy to .env (git-ignored). Values are local-dev placeholders, not secrets.

# Postgres container (docker compose)
POSTGRES_USER=hexabout
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hexabout
POSTGRES_HOST_PORT=5433

# App
PORT=3000
DATABASE_URL=postgres://hexabout:change-me@localhost:5433/hexabout
PG_POOL_SIZE=10
# Leaderboard cache TTL in ms (DESIGN.md: 2 s). 0 = off.
LEADERBOARD_CACHE_MS=2000

# Tests: admin connection used to create and drop a throwaway database per run
TEST_ADMIN_DATABASE_URL=postgres://hexabout:change-me@localhost:5433/postgres

# Load test
TARGET_RPS=540
BASE_URL=http://localhost:3000
